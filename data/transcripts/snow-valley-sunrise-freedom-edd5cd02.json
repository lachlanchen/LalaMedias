  "entries": [
    {
      "start": "00:00:00.000",
      "end": "00:00:00.980",
      "text": "今天先滑到谷底，"
    },
    {
      "start": "00:00:00.980",
      "end": "00:00:02.080",
      "text": "再去山顶看日出！"
    },
    {
      "start": "00:00:02.080",
      "end": "00:00:03.200",
      "text": "自由听起来很浪漫，"
    },
    {
      "start": "00:00:03.200",
      "end": "00:00:04.680",
      "text": "为什么第一步是往下冲？"
    },
    {
      "start": "00:00:04.680",
      "end": "00:00:05.600",
      "text": "因为有些风景，"
    },
    {
      "start": "00:00:05.600",
      "end": "00:00:06.820",
      "text": "要先鼓起勇气下去，"
    },
    {
      "start": "00:00:06.820",
      "end": "00:00:07.860",
      "text": "才看得到上面。"
    },
    {
      "start": "00:00:07.860",
      "end": "00:00:08.740",
      "text": "庄子！"
    },
    {
      "start": "00:00:08.740",
      "end": "00:00:09.740",
      "text": "你不是滑雪，"
    },
    {
      "start": "00:00:09.740",
      "end": "00:00:10.880",
      "text": "你是在提交bug！"
    },
    {
      "start": "00:00:10.880",
      "end": "00:00:11.580",
      "text": "阿芽酱！"
    },
    {
      "start": "00:00:11.580",
      "end": "00:00:11.940",
      "text": "我在！"
    },
    {
      "start": "00:00:11.940",
      "end": "00:00:12.620",
      "text": "啦啦侠！"
    },
    {
      "start": "00:00:12.620",
      "end": "00:00:13.340",
      "text": "我也在！"
    },
    {
      "start": "00:00:13.340",
      "end": "00:00:14.620",
      "text": "也请喊一下我的名字，"
    },
    {
      "start": "00:00:14.620",
      "end": "00:00:16.120",
      "text": "我正在努力感觉自由。"
    },
    {
      "start": "00:00:16.120",
      "end": "00:00:17.180",
      "text": "庄子！"
    },
    {
      "start": "00:00:17.180",
      "end": "00:00:19.620",
      "text": "希望不是一直在高处，"
    },
    {
      "start": "00:00:19.620",
      "end": "00:00:22.100",
      "text": "是你知道自己还能再上去。"
    },
    {
      "start": "00:00:22.100",
      "end": "00:00:23.720",
      "text": "自由不是没有风，"
    },
    {
      "start": "00:00:23.720",
      "end": "00:00:25.340",
      "text": "也不是没有坡。"
    },
    {
      "start": "00:00:25.340",
      "end": "00:00:27.860",
      "text": "自由是有人喊你的名字，"
    },
    {
      "start": "00:00:27.860",
      "end": "00:00:29.980",
      "text": "你知道自己不是一个人。"
    }
  ]
}