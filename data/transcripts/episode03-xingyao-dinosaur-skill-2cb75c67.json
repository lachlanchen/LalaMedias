      "start": "00:00:00.380",
      "end": "00:00:02.360",
      "text": "请把星药和那颗蛋交给我们保管"
    },
    {
      "start": "00:00:02.360",
      "end": "00:00:03.140",
      "text": "等一下"
    },
    {
      "start": "00:00:03.140",
      "end": "00:00:03.920",
      "text": "宇宙U盘还能孵蛋"
    },
    {
      "start": "00:00:03.920",
      "end": "00:00:05.180",
      "text": "这功能也太先进了吧"
    },
    {
      "start": "00:00:05.180",
      "end": "00:00:05.810",
      "text": "不是工具"
    },
    {
      "start": "00:00:05.810",
      "end": "00:00:06.440",
      "text": "是生命信号"
    },
    {
      "start": "00:00:06.440",
      "end": "00:00:07.180",
      "text": "它快出来了"
    },
    {
      "start": "00:00:07.180",
      "end": "00:00:08.119",
      "text": "虽然听起来不专业"
    },
    {
      "start": "00:00:08.119",
      "end": "00:00:08.840",
      "text": "但温度刚刚好"
    },
    {
      "start": "00:00:08.840",
      "end": "00:00:09.800",
      "text": "我不是故意变大的"
    },
    {
      "start": "00:00:09.800",
      "end": "00:00:11.140",
      "text": "它刚出生就会解决问题"
    },
    {
      "start": "00:00:11.140",
      "end": "00:00:11.780",
      "text": "它不是厉害"
    },
    {
      "start": "00:00:11.780",
      "end": "00:00:12.680",
      "text": "它只是太紧张了"
    },
    {
      "start": "00:00:12.680",
      "end": "00:00:13.240",
      "text": "好消息"
    },
    {
      "start": "00:00:13.240",
      "end": "00:00:13.800",
      "text": "有新队友"
    },
    {
      "start": "00:00:13.800",
      "end": "00:00:14.420",
      "text": "坏消息"
    },
    {
      "start": "00:00:14.420",
      "end": "00:00:15.040",
      "text": "它比我大"
    }
  ]
