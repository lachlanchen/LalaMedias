  "entries": [
    {
      "start": "00:00:00.000",
      "end": "00:00:02.280",
      "text": "她是不是要变成宇宙爆米花了"
    },
    {
      "start": "00:00:02.280",
      "end": "00:00:03.180",
      "text": "那叫超新星"
    },
    {
      "start": "00:00:03.180",
      "end": "00:00:04.120",
      "text": "不叫爆米花"
    },
    {
      "start": "00:00:04.120",
      "end": "00:00:04.560",
      "text": "恭喜"
    },
    {
      "start": "00:00:04.560",
      "end": "00:00:06.500",
      "text": "你把急救变成了开业庆典"
    },
    {
      "start": "00:00:06.500",
      "end": "00:00:07.480",
      "text": "先给她姗姗"
    },
    {
      "start": "00:00:07.480",
      "end": "00:00:09.460",
      "text": "别让她一激动炸成艺术烟花"
    },
    {
      "start": "00:00:09.460",
      "end": "00:00:11.620",
      "text": "我能不能先躲到自己后面"
    },
    {
      "start": "00:00:11.620",
      "end": "00:00:15.020",
      "text": "原来超新星也会过敏"
    }
  ]
