  "entries": [
    {
      "start": "00:00:00.000",
      "end": "00:00:02.300",
      "text": "啦啦侠，"
    },
    {
      "start": "00:00:02.300",
      "end": "00:00:03.620",
      "text": "别晃桌子，"
    },
    {
      "start": "00:00:03.620",
      "end": "00:00:05.780",
      "text": "样本快被你吓醒了。"
    },
    {
      "start": "00:00:05.780",
      "end": "00:00:06.400",
      "text": "阿芽酱，"
    },
    {
      "start": "00:00:06.400",
      "end": "00:00:07.900",
      "text": "我是在给它加油。"
    },
    {
      "start": "00:00:07.900",
      "end": "00:00:11.200",
      "text": "庄子，"
    },
    {
      "start": "00:00:11.200",
      "end": "00:00:12.900",
      "text": "左边三厘米！"
    },
    {
      "start": "00:00:12.900",
      "end": "00:00:14.160",
      "text": "收到，"
    },
    {
      "start": "00:00:14.160",
      "end": "00:00:14.920",
      "text": "飒飒君。"
    },
    {
      "start": "00:00:18.700",
      "end": "00:00:20.300",
      "text": "阿芽酱，真的有反应！"
    },
    {
      "start": "00:00:20.300",
      "end": "00:00:21.760",
      "text": "先别庆祝，啦啦侠。"
    },
    {
      "start": "00:00:21.760",
      "end": "00:00:22.600",
      "text": "记录数据。"
    },
    {
      "start": "00:00:22.600",
      "end": "00:00:23.660",
      "text": "我已经记录。"
    },
    {
      "start": "00:00:23.660",
      "end": "00:00:24.680",
      "text": "误差很小。"
    },
    {
      "start": "00:00:24.680",
      "end": "00:00:26.320",
      "text": "庄子，现在！"
    },
    {
      "start": "00:00:26.320",
      "end": "00:00:27.860",
      "text": "今天先救一个"
    },
    {
      "start": "00:00:27.860",
      "end": "00:00:28.880",
      "text": "小小的希望。"
    },
    {
      "start": "00:00:28.880",
      "end": "00:00:30.040",
      "text": "明天继续。"
    }
  ]
}