    {
      "start": "00:00:00.000",
      "end": "00:00:01.380",
      "text": "会不会是很多金币？"
    },
    {
      "start": "00:00:01.380",
      "end": "00:00:02.540",
      "text": "先别撬地板，"
    },
    {
      "start": "00:00:02.540",
      "end": "00:00:04.000",
      "text": "我们要先确认安全。"
    },
    {
      "start": "00:00:04.000",
      "end": "00:00:05.960",
      "text": "不是电线，也不是火。"
    },
    {
      "start": "00:00:05.960",
      "end": "00:00:08.320",
      "text": "下面有一个金属盒子。"
    },
    {
      "start": "00:00:08.320",
      "end": "00:00:13.960",
      "text": "这是爷爷留下来修餐厅的钱。"
    },
    {
      "start": "00:00:13.960",
      "end": "00:00:16.100",
      "text": "那这些金币应该用来修餐厅，"
    },
    {
      "start": "00:00:16.100",
      "end": "00:00:17.340",
      "text": "不应该被我们拿走。"
    },
    {
      "start": "00:00:17.340",
      "end": "00:00:19.700",
      "text": "修好以后，我们可以先吃一碗咖喱饭吗？"
    },
    {
      "start": "00:00:19.700",
      "end": "00:00:20.540",
      "text": "当然可以，"
    },
    {
      "start": "00:00:20.540",
      "end": "00:00:22.240",
      "text": "你已经盯着锅看很久了。"
    },
    {
      "start": "00:00:22.240",
      "end": "00:00:25.360",
      "text": "今天找到的金子在盒子里，"
    },
    {
      "start": "00:00:25.360",
      "end": "00:00:27.100",
      "text": "最香的金色在碗里。"
    },
    {
      "start": "00:00:27.100",
      "end": "00:00:30.120",
      "text": "那我先保护这碗金色咖喱！"
    }
  ]
}