  "entries": [
    {
      "start": "00:00:00.000",
      "end": "00:00:02.100",
      "text": "系统说这里有一条通往奇迹洞穴的小路"
    },
    {
      "start": "00:00:02.100",
      "end": "00:00:03.660",
      "text": "那系统有没有说这里为什么这么吵？"
    },
    {
      "start": "00:00:03.660",
      "end": "00:00:04.700",
      "text": "因为它们在开会，而且好像在讨论我们"
    },
    {
      "start": "00:00:04.700",
      "end": "00:00:05.180",
      "text": "下雨了"
    },
    {
      "start": "00:00:05.180",
      "end": "00:00:06.020",
      "text": "是蝉的尿尿雨"
    },
    {
      "start": "00:00:06.020",
      "end": "00:00:06.540",
      "text": "我的发型"
    },
    {
      "start": "00:00:06.540",
      "end": "00:00:07.080",
      "text": "我的尊严"
    },
    {
      "start": "00:00:07.080",
      "end": "00:00:07.720",
      "text": "我的竹子"
    },
    {
      "start": "00:00:07.720",
      "end": "00:00:09.540",
      "text": "这里不会有更会尿尿的东西吧"
    },
    {
      "start": "00:00:09.540",
      "end": "00:00:09.840",
      "text": "哇"
    },
    {
      "start": "00:00:09.840",
      "end": "00:00:11.260",
      "text": "原来蝉不是在攻击我们"
    },
    {
      "start": "00:00:11.260",
      "end": "00:00:12.660",
      "text": "他们是在把我们赶到这里"
    },
    {
      "start": "00:00:12.660",
      "end": "00:00:14.080",
      "text": "虽然前面的方式很湿润"
    },
    {
      "start": "00:00:14.080",
      "end": "00:00:14.960",
      "text": "但结果很浪漫"
    }
  ]
}