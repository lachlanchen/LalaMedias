    {
      "start": "00:00:00.000",
      "end": "00:00:02.220",
      "text": "北冥之海终将是我的。"
    },
    {
      "start": "00:00:02.220",
      "end": "00:00:03.360",
      "text": "那看你的罪恶，"
    },
    {
      "start": "00:00:03.360",
      "end": "00:00:05.020",
      "text": "还是我的天道谁胜一筹。"
    },
    {
      "start": "00:00:05.020",
      "end": "00:00:06.160",
      "text": "天道在我！"
    },
    {
      "start": "00:00:06.160",
      "end": "00:00:07.800",
      "text": "他山之石，可以攻玉！"
    },
    {
      "start": "00:00:07.800",
      "end": "00:00:09.180",
      "text": "空中支援来了，"
    },
    {
      "start": "00:00:09.180",
      "end": "00:00:10.860",
      "text": "不是手机那个飞行模式。"
    }
  ]
