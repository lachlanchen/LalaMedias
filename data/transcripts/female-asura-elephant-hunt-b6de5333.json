    {
      "start": "00:00:00.000",
      "end": "00:00:02.640",
      "text": "她把不死药抢走了"
    },
    {
      "start": "00:00:02.640",
      "end": "00:00:03.300",
      "text": "别伤大象"
    },
    {
      "start": "00:00:03.300",
      "end": "00:00:03.960",
      "text": "追骑手"
    },
    {
      "start": "00:00:03.960",
      "end": "00:00:07.700",
      "text": "我以为大象都会喜欢香蕉"
    },
    {
      "start": "00:00:07.700",
      "end": "00:00:08.360",
      "text": "那是追踪器"
    },
    {
      "start": "00:00:08.360",
      "end": "00:00:09.040",
      "text": "不是零食"
    },
    {
      "start": "00:00:09.040",
      "end": "00:00:10.040",
      "text": "想拿回不死药"
    },
    {
      "start": "00:00:10.040",
      "end": "00:00:10.880",
      "text": "就来追我"
    },
    {
      "start": "00:00:10.880",
      "end": "00:00:12.400",
      "text": "她拿走的是备用保温杯"
    },
    {
      "start": "00:00:12.400",
      "end": "00:00:12.820",
      "text": "还好"
    },
    {
      "start": "00:00:12.820",
      "end": "00:00:14.440",
      "text": "我的热水比不死药安全一点"
