      "text": "窓辺で小さなアヤちゃん"
    },
    {
      "start": "00:00:05.090",
      "end": "00:00:10.180",
      "text": "雨粒を星に変える"
    },
    {
      "start": "00:00:10.180",
      "end": "00:00:16.020",
      "text": "赤いしっぽ そっと揺れて"
    },
    {
      "start": "00:00:16.020",
      "end": "00:00:21.860",
      "text": "眠る街へ歌を投げた"
    },
    {
      "start": "00:00:21.860",
      "end": "00:00:25.413",
      "text": "怖くないよ"
    },
    {
      "start": "00:00:25.413",
      "end": "00:00:28.966",
      "text": "ここにいるよ"
    },
    {
      "start": "00:00:28.966",
      "end": "00:00:32.519",
      "text": "胸の鈴が夜を照らす"
    },
    {
      "start": "00:00:32.519",
      "end": "00:00:35.449",
      "text": "きらり きらり アヤちゃん"
    },
    {
      "start": "00:00:35.449",
      "end": "00:00:38.379",
      "text": "雲のすきまを走って"
    },
    {
      "start": "00:00:38.379",
      "end": "00:00:47.919",
      "text": "ひとりじゃない 夢は消えない"
    },
    {
      "start": "00:00:47.920",
      "end": "00:00:51.840",
      "text": "光の雨で踊ろう"
    },
    {
      "start": "00:00:51.860",
      "end": "00:00:56.253",
      "text": "朝が来たら ほほえんで"
    },
    {
      "start": "00:00:56.253",
      "end": "00:01:05.039",
      "text": "小さな勇気 花になる"
    }
  ]
