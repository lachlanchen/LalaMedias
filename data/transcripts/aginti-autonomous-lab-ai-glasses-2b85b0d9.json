{
  "slug": "aginti-autonomous-lab-ai-glasses-2b85b0d9",
  "source_subtitle": "media/subtitles/aginti-autonomous-lab-ai-glasses-2b85b0d9/aginti_autonomous_lab_ai_glasses_30s_mixed_polished.srt",
