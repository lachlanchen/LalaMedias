  "entries": [
    {
      "start": "00:00:00.000",
      "end": "00:00:01.700",
      "text": "端午龙舟赛现在开始！"
    },
    {
      "start": "00:00:01.700",
      "end": "00:00:04.420",
      "text": "冠军奖品是一杯超大菠萝西瓜汁！"
    },
    {
      "start": "00:00:04.420",
      "end": "00:00:06.520",
      "text": "这个规则我完全听懂了！"
    },
    {
      "start": "00:00:06.520",
      "end": "00:00:08.000",
      "text": "你是来划船的，不是来提前喝果汁的。"
    },
    {
      "start": "00:00:11.120",
      "end": "00:00:12.320",
      "text": "转得很好看，"
    },
    {
      "start": "00:00:12.320",
      "end": "00:00:13.180",
      "text": "但不算前进！"
    },
    {
      "start": "00:00:13.180",
      "end": "00:00:13.920",
      "text": "比赛暂停，"
    },
    {
      "start": "00:00:13.920",
      "end": "00:00:14.800",
      "text": "先救粽子！"
    },
    {
      "start": "00:00:14.800",
      "end": "00:00:16.100",
      "text": "救粽子就是救节日！"
    },
    {
      "start": "00:00:16.100",
      "end": "00:00:21.900",
      "text": "并列第一！"
    },
    {
      "start": "00:00:21.900",
      "end": "00:00:23.820",
      "text": "特别奖：最会救粽子队！"
    },
    {
      "start": "00:00:23.820",
      "end": "00:00:25.120",
      "text": "那奖品可以现在喝吗？"
    },
    {
      "start": "00:00:25.120",
      "end": "00:00:25.300",
      "text": "可以，"
    },
    {
      "start": "00:00:25.300",
      "end": "00:00:26.540",
      "text": "但冠军要大家一起分。"
    },
    {
      "start": "00:00:26.540",
      "end": "00:00:27.420",
      "text": "龙舟不是只比速度，"
    },
    {
      "start": "00:00:27.420",
      "end": "00:00:28.420",
      "text": "也比大家能不能一起喊——"
    },
    {
      "start": "00:00:28.420",
      "end": "00:00:28.620",
      "text": "嘿！"
    },
    {
      "start": "00:00:28.620",
      "end": "00:00:29.300",
      "text": "端午快乐！"
    },
    {
      "start": "00:00:30.000",
      "end": "00:00:33.420",
      "text": "端午快乐！"
    }
  ]
}