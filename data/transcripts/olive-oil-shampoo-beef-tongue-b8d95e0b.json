    {
      "start": "00:00:00.000",
      "end": "00:00:02.860",
      "text": "谁能守住它，奖品就是一大盘烤牛舌"
    },
    {
      "start": "00:00:02.860",
      "end": "00:00:05.160",
      "text": "哇，这高级洗发水会发光？"
    },
    {
      "start": "00:00:05.460",
      "end": "00:00:07.180",
      "text": "我也想试试头发会不会发光"
    },
    {
      "start": "00:00:07.180",
      "end": "00:00:10.380",
      "text": "等等，这是橄榄油，是用来做菜的"
    },
    {
      "start": "00:00:10.380",
      "end": "00:00:14.100",
      "text": "可以拌沙拉，不建议拌头发"
    },
    {
      "start": "00:00:19.176",
      "end": "00:00:19.856",
      "text": "在屋顶"
    },
    {
      "start": "00:00:19.856",
      "end": "00:00:22.036",
      "text": "请归还物品"
    },
    {
      "start": "00:00:22.036",
      "end": "00:00:23.696",
      "text": "这个发型"
    },
    {
      "start": "00:00:23.696",
      "end": "00:00:25.216",
      "text": "有点想配面包"
    },
    {
      "start": "00:00:25.216",
      "end": "00:00:26.696",
      "text": "这次记住了吧"
    },
    {
      "start": "00:00:26.696",
      "end": "00:00:27.636",
      "text": "记住了"
    },
    {
      "start": "00:00:27.636",
      "end": "00:00:28.976",
      "text": "橄榄油不能洗头"
    },
    {
      "start": "00:00:28.976",
      "end": "00:00:30.716",
      "text": "但是可以让牛舌更香"
    },
    {
      "start": "00:00:30.716",
      "end": "00:00:31.356",
      "text": "这个结论"
    },
    {
      "start": "00:00:31.356",
      "end": "00:00:32.156",
      "text": "我同意"
    }
  ]
