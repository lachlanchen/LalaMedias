      "start": "00:00:00.000",
      "end": "00:00:03.760",
      "text": "如果它真的能延长生命"
    },
    {
      "start": "00:00:03.760",
      "end": "00:00:05.400",
      "text": "就更不能让坏人拿走"
    },
    {
      "start": "00:00:05.400",
      "end": "00:00:08.600",
      "text": "把不死药交出来"
    },
    {
      "start": "00:00:08.600",
      "end": "00:00:09.920",
      "text": "以后谁能活"
    },
    {
      "start": "00:00:09.920",
      "end": "00:00:10.920",
      "text": "由我决定"
    },
    {
      "start": "00:00:10.920",
      "end": "00:00:12.580",
      "text": "生命不是你的奖品"
    },
    {
      "start": "00:00:12.580",
      "end": "00:00:16.379",
      "text": "我按对了吗"
    },
    {
      "start": "00:00:16.379",
      "end": "00:00:20.920",
      "text": "它只回应想救人的心"
    },
    {
      "start": "00:00:20.920",
      "end": "00:00:24.420",
      "text": "我还会回来"
    },
    {
      "start": "00:00:24.420",
      "end": "00:00:28.000",
      "text": "那它能不能让我不用写作业"
    },
    {
      "start": "00:00:28.000",
      "end": "00:00:29.920",
      "text": "不能"
    },
    {
      "start": "00:00:29.920",
      "end": "00:00:31.940",
      "text": "作业也需要生命力"
    },
    {
      "start": "00:00:32.264",
      "end": "00:00:34.264",
      "text": "Hehehehehehe"
    }
