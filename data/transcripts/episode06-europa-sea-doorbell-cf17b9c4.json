  "entries": [
    {
      "start": "00:00:00.160",
      "end": "00:00:01.040",
      "text": "哇"
    },
    {
      "start": "00:00:01.040",
      "end": "00:00:01.920",
      "text": "好大一颗芝麻汤圆"
    },
    {
      "start": "00:00:01.920",
      "end": "00:00:02.650",
      "text": "那是木星"
    },
    {
      "start": "00:00:02.650",
      "end": "00:00:03.380",
      "text": "不是甜品"
    },
    {
      "start": "00:00:03.380",
      "end": "00:00:04.270",
      "text": "你好"
    },
    {
      "start": "00:00:04.270",
      "end": "00:00:05.160",
      "text": "请问海底入口在哪里"
    },
    {
      "start": "00:00:05.160",
      "end": "00:00:06.340",
      "text": "你刚刚敲的门铃"
    },
    {
      "start": "00:00:06.340",
      "end": "00:00:07.520",
      "text": "高级小区都这样"
    },
    {
      "start": "00:00:07.520",
      "end": "00:00:08.440",
      "text": "我不会游泳"
    },
    {
      "start": "00:00:08.440",
      "end": "00:00:09.013",
      "text": "放心"
    },
    {
      "start": "00:00:09.013",
      "end": "00:00:09.586",
      "text": "你这么大"
    },
    {
      "start": "00:00:09.586",
      "end": "00:00:10.159",
      "text": "还应该先害怕"
    },
    {
      "start": "00:00:10.160",
      "end": "00:00:11.720",
      "text": "他们把我们的眼镜当自拍镜了"
    },
    {
      "start": "00:00:11.720",
      "end": "00:00:13.080",
      "text": "请问这是谁家的面包船桨"
    },
    {
      "start": "00:00:13.080",
      "end": "00:00:13.950",
      "text": "如果没人要"
    },
    {
      "start": "00:00:13.950",
      "end": "00:00:14.820",
      "text": "我可以负责吃掉"
    }
  ]
}