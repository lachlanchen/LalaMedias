    {
      "start": "00:00:00.060",
      "end": "00:00:01.040",
      "text": "今天研究生命"
    },
    {
      "start": "00:00:01.040",
      "end": "00:00:02.400",
      "text": "不研究点心失踪案"
    },
    {
      "start": "00:00:02.400",
      "end": "00:00:03.120",
      "text": "样本稳定"
    },
    {
      "start": "00:00:03.120",
      "end": "00:00:04.460",
      "text": "培养皿不需要加油"
    },
    {
      "start": "00:00:04.460",
      "end": "00:00:05.100",
      "text": "微环境"
    },
    {
      "start": "00:00:05.100",
      "end": "00:00:06.440",
      "text": "癌细胞不只自己变化"
    },
    {
      "start": "00:00:06.440",
      "end": "00:00:07.840",
      "text": "也会改变周围的环境"
    },
    {
      "start": "00:00:07.840",
      "end": "00:00:09.560",
      "text": "所以坏主意也会装修房子"
    },
    {
      "start": "00:00:09.560",
      "end": "00:00:10.920",
      "text": "它怕环境被改回正常"
    },
    {
      "start": "00:00:10.920",
      "end": "00:00:11.540",
      "text": "这是线索"
    },
    {
      "start": "00:00:11.540",
      "end": "00:00:12.160",
      "text": "先验证"
    },
    {
      "start": "00:00:12.160",
      "end": "00:00:12.760",
      "text": "那这个也要验证吗？"
    },
    {
      "start": "00:00:12.760",
      "end": "00:00:13.360",
      "text": "验证完成"
    },
    {
      "start": "00:00:13.360",
      "end": "00:00:14.060",
      "text": "里面什么都没有"
    },
    {
      "start": "00:00:14.060",
      "end": "00:00:14.900",
      "text": "科学真残忍"
    }
  ]
