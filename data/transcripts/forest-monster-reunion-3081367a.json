    {
      "start": "00:00:00.000",
      "end": "00:00:01.900",
      "text": "别踩湿石头，会滑。"
    },
    {
      "start": "00:00:01.900",
      "end": "00:00:06.200",
      "text": "阿芽酱，你在哪儿？"
    },
    {
      "start": "00:00:06.200",
      "end": "00:00:07.840",
      "text": "我这里有饼干，你别慌！"
    },
    {
      "start": "00:00:07.840",
      "end": "00:00:09.180",
      "text": "你先别管饼干"
    },
    {
      "start": "00:00:09.180",
      "end": "00:00:11.300",
      "text": "往发光的萤火虫这边走"
    },
    {
      "start": "00:00:11.300",
      "end": "00:00:14.260",
      "text": "我被森林抓住了！"
    },
    {
      "start": "00:00:14.260",
      "end": "00:00:22.100",
      "text": "原来你们是靠零食导航？"
    },
    {
      "start": "00:00:22.100",
      "end": "00:00:23.860",
      "text": "路线不标准，但有效。"
    },
    {
      "start": "00:00:30.000",
      "end": "00:00:30.104",
      "text": "优优独播剧场——YoYo"
    },
