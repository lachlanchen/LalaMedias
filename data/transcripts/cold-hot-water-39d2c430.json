  "entries": [
    {
      "start": "00:00:00.000",
      "end": "00:00:03.720",
      "text": "魔法森林的小屋里,三个小伙伴都感冒了。"
    },
    {
      "start": "00:00:04.000",
      "end": "00:00:07.220",
      "text": "我没事,我只是鼻子在练习打鼓。"
    },
    {
      "start": "00:00:07.660",
      "end": "00:00:10.560",
      "text": "感冒的时候要互相照顾,先喝热水。"
    },
    {
      "start": "00:00:10.940",
      "end": "00:00:12.040",
      "text": "这要能量体温吗?"
    },
    {
      "start": "00:00:12.480",
      "end": "00:00:14.520",
      "text": "你娘出来可能是聪明温度。"
    },
    {
      "start": "00:00:16.420",
      "end": "00:00:18.820",
      "text": "明天再一起打败喷嚏大王吧。"
    }
  ]
}