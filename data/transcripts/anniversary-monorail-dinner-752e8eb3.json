  "entries": [
    {
      "start": "00:00:00.260",
      "end": "00:00:00.840",
      "text": "冷"
    },
    {
      "start": "00:00:00.840",
      "end": "00:00:05.000",
      "text": "我们坐那辆车去餐厅吧。今天是 anniversary，要好好吃一顿。"
    },
    {
      "start": "00:00:05.000",
      "end": "00:00:08.080",
      "text": "车票找到了"
    },
    {
      "start": "00:00:08.080",
      "end": "00:00:10.000",
      "text": "现在可以上车。"
    },
    {
      "start": "00:00:10.000",
      "end": "00:00:13.000",
      "text": "不要硬切。"
    },
    {
      "start": "00:00:13.000",
      "end": "00:00:17.760",
      "text": "要顺着牛肉的纹路切。"
    },
    {
      "start": "00:00:17.760",
      "end": "00:00:20.920",
      "text": "这里有小烟花机关。它很安全，不会碰到食物。"
    },
    {
      "start": "00:00:20.920",
      "end": "00:00:22.780",
      "text": "一"
    },
    {
      "start": "00:00:22.780",
      "end": "00:00:23.480",
      "text": "二"
    },
    {
      "start": "00:00:23.480",
      "end": "00:00:24.120",
      "text": "三"
    },
    {
      "start": "00:00:24.120",
      "end": "00:00:26.900",
      "text": "今天的晚餐有一点难"
    },
    {
      "start": "00:00:26.900",
      "end": "00:00:28.140",
      "text": "但很好玩"
    },
    {
      "start": "00:00:28.140",
      "end": "00:00:28.920",
      "text": "庄子机器人认真记录："
    },
    {
      "start": "00:00:28.920",
      "end": "00:00:34.040",
      "text": "寒い的夜晚，monorail，lobster，beef，小烟花，anniversary 成功。"
    }
  ]
}