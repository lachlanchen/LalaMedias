  "entries": [
    {
      "start": "00:00:00.000",
      "end": "00:00:00.960",
      "text": "哇"
    },
    {
      "start": "00:00:00.960",
      "end": "00:00:01.920",
      "text": "这比商场扶梯高级多了"
    },
    {
      "start": "00:00:01.920",
      "end": "00:00:03.460",
      "text": "今天我们的任务，是检查地球到火星的大桥"
    },
    {
      "start": "00:00:03.460",
      "end": "00:00:04.150",
      "text": "地球到火星有桥？"
    },
    {
      "start": "00:00:04.150",
      "end": "00:00:04.840",
      "text": "那堵车怎么办？"
    },
    {
      "start": "00:00:04.840",
      "end": "00:00:05.466",
      "text": "前往火星"
    },
    {
      "start": "00:00:05.466",
      "end": "00:00:06.093",
      "text": "请走右边"
    },
    {
      "start": "00:00:06.093",
      "end": "00:00:06.719",
      "text": "绳索通道"
    },
    {
      "start": "00:00:06.720",
      "end": "00:00:07.660",
      "text": "火星大桥修到一半"
    },
    {
      "start": "00:00:07.660",
      "end": "00:00:08.600",
      "text": "施工队饿了"
    },
    {
      "start": "00:00:08.600",
      "end": "00:00:10.140",
      "text": "如果我飞走，就说明需要改进！"
    },
    {
      "start": "00:00:10.140",
      "end": "00:00:11.540",
      "text": "这个交通工具没有刹车吗？"
    },
    {
      "start": "00:00:11.540",
      "end": "00:00:12.050",
      "text": "有，"
    },
    {
      "start": "00:00:12.050",
      "end": "00:00:12.560",
      "text": "靠心理崩溃减速"
    },
    {
      "start": "00:00:12.560",
      "end": "00:00:15.000",
      "text": "施工队可以回来修桥了！"
    },
    {
      "start": "00:00:15.000",
      "end": "00:00:15.080",
      "text": "回来"
    }
  ]
}