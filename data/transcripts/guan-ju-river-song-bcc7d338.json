  ],
  "entries": [
    {
      "start": "00:00:00.000",
      "end": "00:00:01.960",
      "text": "关关"
    },
    {
      "start": "00:00:01.960",
      "end": "00:00:04.920",
      "text": "它们是不是在说早饭开饭了？"
    },
    {
      "start": "00:00:04.920",
      "end": "00:00:05.940",
      "text": "不是啦"
    },
    {
      "start": "00:00:05.940",
      "end": "00:00:08.020",
      "text": "它们是在互相叫对方"
    },
    {
      "start": "00:00:08.020",
      "end": "00:00:13.120",
      "text": "它们有点感动"
    },
    {
      "start": "00:00:13.120",
      "end": "00:00:15.040",
      "text": "也有点怀疑你的审美"
    },
    {
      "start": "00:00:15.040",
      "end": "00:00:16.360",
      "text": "喜欢一个人"
    },
    {
      "start": "00:00:16.360",
      "end": "00:00:17.420",
      "text": "不一定要大喊"
    },
    {
      "start": "00:00:17.420",
      "end": "00:00:18.800",
      "text": "慢慢靠近也很好"
    },
    {
      "start": "00:00:18.800",
      "end": "00:00:19.200",
      "text": "懂了"
    },
    {
      "start": "00:00:19.200",
      "end": "00:00:20.420",
      "text": "就像我看见好吃的"
    },
    {
      "start": "00:00:20.420",
      "end": "00:00:21.400",
      "text": "也要先保持礼貌"
    },
    {
      "start": "00:00:21.400",
      "end": "00:00:23.340",
      "text": "你那是在等我先拍照"
    },
    {
      "start": "00:00:23.340",
      "end": "00:00:26.720",
      "text": "关关雎鸠"
    },
    {
      "start": "00:00:26.720",
      "end": "00:00:28.220",
      "text": "在河之洲"
    },
    {
      "start": "00:00:28.220",
      "end": "00:00:31.200",
      "text": "下次我来负责摆水草"
    }
  ]
}